<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:CadastroClientes.Behaviors"
             x:Class="CadastroClientes.Views.TecnicoPage"
             Shell.NavBarIsVisible="False"
             Title="Solicitar Peças"
             BackgroundColor="#16315e">
    
    <ContentPage.Resources>
        <ColumnDefinitionCollection x:Key="ColunasTabela">
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </ColumnDefinitionCollection>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Label
            x:Name="lblTitulo"
            Text="Solicitar Peças"
            FontSize="30"
            FontAttributes="Bold"
            TextColor="White"
            Margin="0,30,0,0"
            Grid.Row="0"
            HorizontalOptions="Center"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="Campos" Padding="50" Spacing="10">

                <Grid
                    x:Name="GridCampos"
                    ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="25">

                    <!-- Linha 0 -->
                    <VerticalStackLayout x:Name="cOs" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                        <Label Text="OS" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}">
                            <Entry x:Name="eOs" Style="{StaticResource EntryCampo}" Placeholder="OS" IsEnabled="False" BackgroundColor="LightGray" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cGarantia" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" Spacing="5" >
                        <Label Text="Garantia" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}" WidthRequest="40" HorizontalOptions="Start" BackgroundColor="LightGray">
                            <CheckBox x:Name="cbGarantia" Color="YellowGreen" IsEnabled="False"  />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cEmissao" Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2" Spacing="5">
                        <Label Text="Data Emissão*" Style="{StaticResource LabelCampo}" />
                        <Border x:Name="bEmissao" Style="{StaticResource BordaCampo}" BackgroundColor="LightGray">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">

                                <Entry x:Name="eEmissao" Style="{StaticResource EntryCampo}" Keyboard="Numeric" Placeholder="dd/mm/aaaa" 
                                    Margin="0,0,0,0" IsEnabled="False">
                                    <Entry.Behaviors>
                                        <behaviors:MascaraBehavior Tipo="Data" />
                                    </Entry.Behaviors>
                                </Entry>

                                <Grid Grid.Column="1" WidthRequest="40" IsClippedToBounds="True">
                                    <Label x:Name="lblIconeData" Text="📅" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />

                                    <DatePicker x:Name="pEmissao" Opacity="0" IsEnabled="False" />
                                </Grid>

                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Linha 1 -->
                    <VerticalStackLayout x:Name="cAparelho" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5">
                        <Label Text="Aparelho*" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}" BackgroundColor="LightGray">
                            <Picker x:Name="pAparelho" Style="{StaticResource PickerCampo}" IsEnabled="False"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cMarca" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Spacing="5">
                        <Label Text="Marca" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}">
                            <Picker x:Name="pMarca" Style="{StaticResource PickerCampo}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cCodigo" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Spacing="5">
                        <Label Text="Código" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}">
                            <Entry x:Name="eCodigo" Style="{StaticResource EntryCampo}" Placeholder="Código" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cSerie" Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="4" Spacing="5">
                        <Label Text="Nro Série" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}">
                            <Entry x:Name="eSerie" Style="{StaticResource EntryCampo}" Placeholder="Nro Série" />
                        </Border>
                    </VerticalStackLayout>
    
                    <!-- Linha 2 -->
                    <VerticalStackLayout x:Name="cDefeito" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="12" Spacing="5">
                        <Label Text="Defeito" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}">
                            <Editor x:Name="eDefeito" Placeholder="Defeito" HeightRequest="100" AutoSize="Disabled" TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Linha 3 -->
                    <VerticalStackLayout x:Name="cCondAparelho" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="12" Spacing="5">
                        <Label Text="Condição do Aparelho" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}">
                            <Entry x:Name="eCondAparelho" Style="{StaticResource EntryCampo}" Placeholder="Condição do Aparelho" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Linha 4 -->
                    <VerticalStackLayout x:Name="cCabo" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="1" Spacing="5">
                        <Label Text="Cabo AC" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}" WidthRequest="40" HorizontalOptions="Start">
                            <CheckBox x:Name="cbCabo" Color="YellowGreen" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cControle" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="1" Spacing="5">
                        <Label Text="Controle" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}" WidthRequest="40" HorizontalOptions="Start">
                            <CheckBox x:Name="cbControle" Color="YellowGreen" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cBase" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="1" Spacing="5">
                        <Label Text="Base" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}" WidthRequest="40" HorizontalOptions="Start">
                            <CheckBox x:Name="cbBase" Color="YellowGreen" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cSuporte" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="1" Spacing="5">
                        <Label Text="Suporte" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}" WidthRequest="40" HorizontalOptions="Start">
                            <CheckBox x:Name="cbSuporte" Color="YellowGreen" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cCaixaAc" Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2" Spacing="5">
                        <Label Text="Caixa Acust" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}" WidthRequest="40" HorizontalOptions="Start">
                            <CheckBox x:Name="cbCaixaAc" Color="YellowGreen" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cOutroAcess" Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="4" Spacing="5">
                        <Label Text="Outro Acessório" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}">
                            <Entry x:Name="eOutroAcess" Style="{StaticResource EntryCampo}" Placeholder="Outro Acessório" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="cObservacao" Grid.Row="4" Grid.Column="9" Grid.ColumnSpan="4" Spacing="5">
                        <Label Text="Observação" Style="{StaticResource LabelCampo}" />
                        <Border Style="{StaticResource BordaCampo}">
                            <Button Text="+ Adicionar observação" Style="{StaticResource BotaoAzul}" Clicked="OnAdicionarObservacaoClicked" />
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        Grid.Row="5"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Grid.ColumnSpan="12"
                        Padding="20">

                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10">
                                <Label Text="Peças" FontSize="20" FontAttributes="Bold"
                                    TextColor="#16315e" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="+ Adicionar peça" Style="{StaticResource BotaoImprimir}" Clicked="OnAdicionarPecaClicked" />
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="{StaticResource ColunasTabela}"
                                BackgroundColor="#F1F5F9"
                                Padding="10,12">

                                <Label Grid.Column="0" HorizontalOptions="Center" Text="Peça" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Grid.Column="1" HorizontalOptions="Center" Text="Qtde" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Grid.Column="2" HorizontalOptions="Center" Text="Cod Peça" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Grid.Column="3" HorizontalOptions="Center" Text="Ações" FontAttributes="Bold" TextColor="#0F172A" />
                            </Grid>

                            <CollectionView
                                x:Name="cvPecas"
                                Grid.Row="2"
                                SelectionMode="None"
                                EmptyView="Nenhum cliente cadastrado.">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout>

                                            <Grid ColumnDefinitions="{StaticResource ColunasTabela}" Padding="10,10" ColumnSpacing="0">

                                                <Label Grid.Column="0" Text="{Binding Nome}" HorizontalOptions="Center" VerticalOptions="Center" 
                                                       TextColor="#000" />

                                                <Label Grid.Column="1" Text="{Binding Qtde}" HorizontalOptions="Center" VerticalOptions="Center" 
                                                       TextColor="#000" LineBreakMode="TailTruncation" />

                                                <Label Grid.Column="2" Text="{Binding CodigoPeca}" HorizontalOptions="Center" VerticalOptions="Center" 
                                                       TextColor="#000" LineBreakMode="TailTruncation" />

                                                <HorizontalStackLayout Grid.Column="3" Spacing="1" HorizontalOptions="Center">
                                                    <Button Text="Editar" Style="{StaticResource BotaoAzul}" Clicked="OnEditarPecaClicked" />

                                                    <Button Text="Apagar" Style="{StaticResource BotaoVermelho}" Clicked="OnApagarPecaClicked" />
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </Grid>
                    </Border>

                    <Border x:Name="cBotaoConfirmar" Grid.Row="6" Grid.Column="7" Grid.ColumnSpan="3" WidthRequest="200" Style="{StaticResource BordaMenu}" 
                        HorizontalOptions="End" VerticalOptions="Center">
                        <Button Text="Confirmar" FontAttributes="Bold" Style="{StaticResource BotaoAzul}" Clicked="OnClickedSalvarOs" />
                    </Border>
                    <Border x:Name="cBotaoVoltar" Grid.Row="6" Grid.Column="10" Grid.ColumnSpan="3" WidthRequest="200" Style="{StaticResource BordaMenu}" 
                            HorizontalOptions="End" VerticalOptions="Center">
                        <Button Text="Voltar" FontAttributes="Bold" Style="{StaticResource BotaoVermelho}" Clicked="btnVoltarClicked" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="GridModal" Grid.Row="0" Grid.RowSpan="2" IsVisible="False">
            <BoxView Color="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelarGridModal" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border 
                x:Name="ConfirmacaoExclusaoBorder"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="24"
                WidthRequest="400"
                MaximumWidthRequest="500"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="12" x:Name="ConfirmacaoExclusao">
                    <Label Text="Deseja realmente excluir esta peça?" FontSize="20" FontAttributes="Bold" TextColor="#16315e" HorizontalOptions="Center" />
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Button Text="Excluir" Style="{StaticResource BotaoVermelho}" Clicked="OnExcluirPeca" />
                        <Button Text="Cancelar" Style="{StaticResource BotaoAzul}" Clicked="OnCancelarGridModal" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </Border>

            <Border 
                x:Name="ModalBorderEdicao"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="24"
                WidthRequest="400"
                MaximumWidthRequest="500"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="12" x:Name="AddPeca">
                    <Label x:Name="lTituloGridModal" Text="Adicionar Peça"
                       FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />

                    <Label Text="PARA ADICIONAR MÃO DE OBRA LANCE O CODIGO PEÇA COMO 0" FontSize="10" FontAttributes="Bold"
                        TextColor="#0F172A" VerticalOptions="Center" Margin="20,0,0,0" />

                    <Label Text="Peça" TextColor="#475569" />
                    <Border Style="{StaticResource BordaCampo}">
                        <Entry x:Name="ePecaNome" Style="{StaticResource EntryCampo}" />
                    </Border>

                    <Label Text="Código Peça" TextColor="#475569" />
                    <Border Style="{StaticResource BordaCampo}">
                        <Entry x:Name="ePecaCodigo" Style="{StaticResource EntryCampo}" />
                    </Border>

                    <Label Text="Quantidade" TextColor="#475569" />
                    <Border Style="{StaticResource BordaCampo}">
                        <Entry x:Name="ePecaQtde" Style="{StaticResource EntryCampo}"
                           Keyboard="Numeric" Text="1" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Grid.Column="0" Text="Salvar" Style="{StaticResource BotaoAzul}" Clicked="OnSalvarGridModal" />
                        <Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BotaoVermelho}" Clicked="OnCancelarGridModal" />
                    </Grid>

                </VerticalStackLayout>

            </Border>
        </Grid>

        <Grid x:Name="GridModalObs" Grid.Row="0" Grid.RowSpan="2" IsVisible="False">
            <BoxView Color="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelarGridModalObs" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border 
                x:Name="ModalBorderObs"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="24"
                WidthRequest="400"
                MaximumWidthRequest="500"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="12" x:Name="AddObs">
                    <Label x:Name="lTituloGridModalObs" Text="Adicionar Observação"
                           FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />

                    <Label Text="Observações" Style="{StaticResource LabelCampo}" />
                    <Border Style="{StaticResource BordaCampo}">
                        <Editor x:Name="eObservacao" Placeholder="Observação" HeightRequest="100" AutoSize="Disabled" TextColor="#0F172A" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Grid.Column="0" Text="Salvar" Style="{StaticResource BotaoAzul}" Clicked="OnSalvarGridModalObs" />
                        <Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BotaoVermelho}" Clicked="OnCancelarGridModalObs" />
                    </Grid>

                </VerticalStackLayout>

            </Border>
        </Grid>
    </Grid>
</ContentPage>